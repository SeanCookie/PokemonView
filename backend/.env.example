# Server
PORT=808
DEFAULT_CURRENCY=USD
DEFAULT_REGION=US

# Public site URL for password-reset links (no trailing slash). Falls back to request Host if unset.
# APP_PUBLIC_URL=http://localhost:828

# SMTP (optional — without these, reset links are printed to the server console)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="Infinity Cards <noreply@example.com>"

# Comma-separated usernames with admin dashboard access
# ADMIN_USERNAMES=yourusername

# Set / TCGplayer link pricing refresh (milliseconds; default 3600000 = 1 hour)
# TCG_LINK_PRICE_PREWARM_INTERVAL_MS=3600000
# TCG_LINK_PRICE_CACHE_TTL_MS=3600000
# SET_PRICING_CACHE_TTL_MS=3600000

# eBay (official API)
EBAY_APP_ID=
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# TCGplayer
TCGPLAYER_PUBLIC_KEY=
TCGPLAYER_PRIVATE_KEY=
TCGPLAYER_API_VERSION=v1.39.0

# pokedata.io
POKEDATA_API_KEY=

# PriceCharting
PRICECHARTING_API_TOKEN=

# PSA Public API
PSA_ACCESS_TOKEN=

# Power Packs chase board (proxied at /api/power-packs/chase/*)
# Primary API host (default: GameStop Power Packs site).
POWER_PACKS_CHASE_ORIGIN=https://powerpacks.gamestop.com
# Optional Cookie header copied from your browser while logged in on that site
# (Application → Cookies) if /api/chase returns 403 from this machine.
POWER_PACKS_COOKIE=
# Optional second base URL tried after the primary fails (same /api/chase paths).
# Also used for slab JPEGs at /img/<id> when the primary host blocks image fetches.
CHASE_MIRROR_ORIGIN=
