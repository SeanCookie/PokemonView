# Production template for https://pokemonview.com
# Copy to backend/.env on the server (never commit the real .env file).
#
# Cloudflare Containers: use wrangler.toml [vars] + `wrangler secret put` instead.
# See docs/cloudflare-hosting.md

NODE_ENV=production
PORT=808
# On GoDaddy Node.js PaaS, PORT is set automatically — omit or leave unset.
# On Cloudflare Containers, PORT=8080 is set in the Dockerfile / worker env.
APP_PUBLIC_URL=https://pokemonview.com

DEFAULT_CURRENCY=USD
DEFAULT_REGION=US

# Google Cloud Console → OAuth client → Authorized JavaScript origins:
#   https://pokemonview.com
GOOGLE_CLIENT_ID=

ADMIN_USERNAMES=yourusername

# Optional — password reset emails
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="Pokemon View <noreply@pokemonview.com>"

TCGPLAYER_PUBLIC_KEY=
TCGPLAYER_PRIVATE_KEY=
TCGPLAYER_API_VERSION=v1.39.0

POKEDATA_API_KEY=
PRICECHARTING_API_TOKEN=
PSA_ACCESS_TOKEN=

EBAY_APP_ID=
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
