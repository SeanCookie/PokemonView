# Cloudflare Containers / Workers secrets
# Set each value with:  npx wrangler secret put NAME
# Never commit real values.

# Required for Google sign-in
GOOGLE_CLIENT_ID=

# Comma-separated admin usernames (same as before)
ADMIN_USERNAMES=

# Pricing / marketplace APIs (optional but recommended)
TCGPLAYER_PUBLIC_KEY=
TCGPLAYER_PRIVATE_KEY=
TCGPLAYER_API_VERSION=v1.39.0
POKEDATA_API_KEY=
PRICECHARTING_API_TOKEN=
PSA_ACCESS_TOKEN=
EBAY_APP_ID=
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# Password reset emails (optional)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="Pokemon View <noreply@pokemonview.com>"

# Power Packs chase proxy (optional)
# POWER_PACKS_COOKIE=
