# Secrets — never commit
backend/.env
.env
.env.local
.env.*.local

# Dependencies
node_modules/
backend/node_modules/

# OS / editor
.DS_Store
Thumbs.db
desktop.ini
*.swp
*~

# Logs and temp
*.log
npm-debug.log*
.cache/

# Archives (deploy zips, accidental copies — use folders under backend/data/ instead)
**/*.zip

# Generated deploy staging folders
deploy/staging-*/

# Corrupt JSON backups from interrupted writes
backend/data/**/*.corrupt-*.bak

# Playwright browser downloads (optional dependency)
.playwright/
ms-playwright/

# Local test entry (not part of production app)
app-test.js

# Dev / import tooling (not part of production deploy)
backend/scripts/
DEPLOY-*.md

# Root scripts — only noop-build.js is tracked for PaaS build step
scripts/*
!scripts/noop-build.js
!scripts/cf-build.js
!scripts/localize-catalog.js
